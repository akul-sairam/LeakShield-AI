{
    "manifest_version": 3,
    "name": "LeakShield AI",
    "version": "1.0",
    "description": "AI-powered privacy guardian for your prompts.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "unlimitedStorage"
    ],
    "host_permissions": [
        "https://*.chatgpt.com/*",
        "https://*.claude.ai/*",
        "https://*.gemini.google.com/*",
        "https://*.perplexity.ai/*",
        "https://poe.com/*",
        "https://www.meta.ai/*",
        "https://x.com/*",
        "https://github.com/*",
        "https://huggingface.co/*",
        "https://cdn.jsdelivr.net/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.chatgpt.com/*",
                "https://*.claude.ai/*",
                "https://*.gemini.google.com/*",
                "https://*.perplexity.ai/*",
                "https://poe.com/*",
                "https://www.meta.ai/*",
                "https://x.com/i/grok*",
                "https://github.com/copilot*",
                "https://huggingface.co/chat/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "lib/transformers.js",
                "lib/*.wasm"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
}